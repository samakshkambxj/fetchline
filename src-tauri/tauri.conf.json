{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fetchline",
  "version": "0.1.0",
  "identifier": "dev.fetchline.app",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fetchline",
        "width": 1080,
        "height": 720,
        "minWidth": 840,
        "minHeight": 560,
        "url": "main.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.svg"],
    "category": "Utility"
  }
}
